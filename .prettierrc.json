{
    "tabWidth": 4,
    "printWidth": 1000000,
    "semi": true,
    "singleQuote": false,
    "arrowParens": "avoid",
    "overrides": [
        {
            "files": "**/*.yml",
            "options": {
                "tabWidth": 2
            }
        },
        {
            "files": "*.svg",
            "options": {
                "parser": "html",
                "htmlWhitespaceSensitivity": "ignore"
            }
        }
    ]
}
