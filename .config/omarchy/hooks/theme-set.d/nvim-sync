#!/bin/bash

# This hook is called with the snake-cased name of the theme that has just been set.
# Every Neovim instance auto-starts an RPC server at $XDG_RUNTIME_DIR/nvim.<pid>.0,
# so push the theme sync command straight to each one instead of waiting for its
# FocusGained/VimResume fallback check to notice the theme file changed.

RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}"

for sock in "$RUNTIME_DIR"/nvim.*.0; do
  [[ -S $sock ]] || continue
  nvim --server "$sock" --remote-send '<Cmd>OmarchyThemeSync<CR>' >/dev/null 2>&1 &
done
wait
