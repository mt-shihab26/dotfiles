{
  "manifest_version": 3,
  "name": "YouTube No Number Keys",
  "version": "1.0",
  "description": "Stops the 0-9 keys from jumping around the YouTube timeline",
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*", "*://*.youtube-nocookie.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
