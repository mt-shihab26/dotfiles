#!/bin/bash

set -e

REPO_DIR="$HOME/Notes"

# Sends a silent desktop notification, with the app name prepended to the summary
notify() {
    notify-send -a notes "notes — $1" "$2" || true
}

# Runs a command, and on failure notifies with its last line of output and exits
run() {
    local output
    if ! output=$("$@" 2>&1); then
        printf '%s\n' "$output" >&2
        notify "Sync Finished" "Sync failed: $(tail -n 1 <<<"$output")"
        exit 1
    fi
    [[ -n $output ]] && printf '%s\n' "$output"
    return 0
}

if ! cd "$REPO_DIR"; then
    notify "Sync Finished" "Sync failed: $REPO_DIR not found"
    exit 1
fi

run git add -A

# Nothing changed, so stay silent
if git diff --cached --quiet; then
    exit 0
fi

notify "Uploading to GitHub" "Local changes are being uploaded..."
run git commit -m "sync: $(date '+%a, %-d %b %Y, %-I:%M %p (UTC%:z)')"
run git push origin HEAD
notify "Sync Finished" "Pushed local changes to GitHub"
