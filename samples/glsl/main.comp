#version 450 core

// compute shader: general-purpose GPU work, not part of the rendering pipeline
layout (local_size_x = 8, local_size_y = 8) in;

layout (rgba32f, binding = 0) uniform image2D uImage;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    vec2 uv = vec2(pixel) / vec2(imageSize(uImage));
    imageStore(uImage, pixel, vec4(uv, 0.0, 1.0));
}
