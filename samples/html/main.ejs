<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title><%= title %></title>
</head>
<body class="p-4">
    <%# list the users, or say there are none %>
    <% if (users.length) { %>
        <ul>
            <% users.forEach((user) => { %>
                <li><%= user.name %> &lt;<%- user.email %>&gt;</li>
            <% }) %>
        </ul>
    <% } else { %>
        <p>No users yet.</p>
    <% } %>
    <%- include("footer", { year: new Date().getFullYear() }) %>
</body>
</html>
